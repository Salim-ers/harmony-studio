# Réserver l'accès au propriétaire (pas de création de compte publique)
ADMIN_EMAIL=admin@harmonysolutions.fr
# À générer avec: npm run hash-password -- pas de mot de passe en clair en production
ADMIN_PASSWORD_HASH=scrypt:REMPLACER
SESSION_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_DE_32_CARACTERES_MINIMUM

# Base de données PostgreSQL Neon
DATABASE_URL=postgresql://...

# Recherche web : https://api-dashboard.search.brave.com
BRAVE_SEARCH_API_KEY=

# Génération IA : https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Vercel Storage > Blob, nécessaire pour les photos
BLOB_READ_WRITE_TOKEN=

# Authentification de la veille quotidienne Vercel Cron
CRON_SECRET=REMPLACER_PAR_UN_AUTRE_SECRET_ALEATOIRE
