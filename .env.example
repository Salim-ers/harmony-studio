# ════════════════════════════════════════════════════════════════════════
#  Harmony Studio — variables d'environnement (EXEMPLE, aucune valeur réelle)
#  Copier en .env.local pour le local ; sur Vercel : Settings → Environment Variables.
#  Détails, coûts et rotation : ENVIRONMENT.md
# ════════════════════════════════════════════════════════════════════════

# ── OBLIGATOIRE : accès propriétaire unique ───────────────────────────────
ADMIN_EMAIL=votre-adresse@exemple.fr
# Générer avec : npm run hash-password   (jamais de mot de passe en clair)
ADMIN_PASSWORD_HASH=scrypt:REMPLACER
# 32 caractères minimum : openssl rand -hex 32
SESSION_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_DE_64_CARACTERES
# Double authentification TOTP (fortement recommandé) : npm run totp:generate
ADMIN_TOTP_SECRET=

# ── OBLIGATOIRE : base de données Neon PostgreSQL ─────────────────────────
# Format : postgresql://<utilisateur>:<mot-de-passe>@<hote>.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Facultatif : forcer le driver (neon | pg). Par défaut : neon, ou pg si localhost.
DATABASE_DRIVER=

# ── OBLIGATOIRE : API Claude (facturation API Anthropic, ≠ abonnement Claude.ai)
ANTHROPIC_API_KEY=
# Modèle par défaut (modifiable ensuite dans Paramètres → Intégrations & coûts)
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── OBLIGATOIRE pour la prospection : Brave Search API ────────────────────
BRAVE_SEARCH_API_KEY=

# ── Veille planifiée (Vercel Cron) ────────────────────────────────────────
# openssl rand -hex 24
CRON_SECRET=
# 1 = cron horaire (Vercel Pro uniquement, modifier aussi vercel.json)
CRON_HOURLY=

# ── FACULTATIF : runner isolé (construction/tests des applications) ───────
# Vercel Sandbox : sur Vercel, l'authentification OIDC est automatique.
SANDBOX_ENABLED=
SANDBOX_VERCEL_TOKEN=
SANDBOX_VERCEL_TEAM_ID=
SANDBOX_VERCEL_PROJECT_ID=

# ── FACULTATIF : publication des projets clients ──────────────────────────
# Jeton GitHub fine-grained (Administration + Contents : lecture/écriture)
GITHUB_TOKEN=
GITHUB_OWNER=
# Jeton Vercel dédié aux déploiements des sites clients (portée minimale)
VERCEL_DEPLOY_TOKEN=
VERCEL_DEPLOY_TEAM_ID=

# ── FACULTATIF : isolation renforcée des aperçus ──────────────────────────
# Domaine distinct pointant vers ce même projet Vercel, ex. https://apercu.mondomaine.fr
PREVIEW_ORIGIN=
# Origine publique de Harmony Studio, ex. https://studio.mondomaine.fr
APP_ORIGIN=

# ── Sessions (facultatif) ─────────────────────────────────────────────────
SESSION_TTL_HOURS=72
SESSION_IDLE_HOURS=12

# ── TESTS LOCAUX UNIQUEMENT ───────────────────────────────────────────────
# 1 = réponses Brave/Claude SIMULÉES et marquées « Donnée de test ».
# Ignoré automatiquement sur Vercel. Ne jamais activer en production.
HARMONY_MOCKS=
