    "@vercel/sandbox": "3.8.0",
    "diff": "8.0.4",
    "esbuild": "0.25.12",
    "fflate": "0.8.3",
    "lucide-react": "0.577.0",
    "motion": "12.43.0",
    "next": "15.5.28",
    "node-html-parser": "9.0.5",
    "pg": "8.23.1",
    "react": "19.1.10",
    "react-dom": "19.1.10",
